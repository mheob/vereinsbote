# Copy to .env and adjust. Values are trimmed and validated at startup (src/server/env.ts).

# Required. PostgreSQL connection string (postgres:// or postgresql://).
DATABASE_URL=postgres://vereinsbote:vereinsbote@localhost:5432/vereinsbote

# Required. Public base URL of the app: the origin only (scheme, host, optional port), without a
# path, query or fragment. https:// only; http:// is allowed for localhost and 127.0.0.1.
APP_URL=http://localhost:3000
# Sign-in requests are rate limited per client address. Node/Docker must run behind a reverse
# proxy that sets X-Forwarded-For to the single client address (nginx:
# `proxy_set_header X-Forwarded-For $remote_addr;`), otherwise all clients share one limit.
# Cloudflare (CF-Connecting-IP) and Vercel (X-Forwarded-For) provide it themselves.

# Required. Base64 of exactly 32 random bytes (encrypts stored credentials with AES-GCM).
# Generate: openssl rand -base64 32
APP_SECRET=

# Required. At least 32 characters. Authenticates the scheduled tick (cron, self-trigger).
# Generate: openssl rand -hex 32
CRON_SECRET=

# Optional. At least 24 characters. Protects the first-time setup page until the first admin exists.
# Generate: openssl rand -hex 16
SETUP_TOKEN=

# Optional. Microsoft sign-in. Set all three or none.
# Entra app registration: redirect URI <APP_URL>/api/auth/callback/microsoft, and the optional
# ID token claim `verified_primary_email`, so an invited user is linked by a verified address.
# MS_LOGIN_TENANT_ID is the club's "Directory (tenant) ID", a GUID such as
# 00000000-0000-0000-0000-000000000000. `common`, `organizations` and `consumers` are refused: they
# would accept accounts of any tenant.
MS_LOGIN_CLIENT_ID=
MS_LOGIN_CLIENT_SECRET=
MS_LOGIN_TENANT_ID=

# Optional. Development only. SMTP URL for system mails (e.g. Mailpit), smtp://host:port.
DEV_SMTP_URL=

# Optional. Development only, for the local Cloudflare smoke test (README): a local Neon WebSocket
# proxy as host:port/path, e.g. localhost:4444/v1. The Neon driver then talks to it without TLS,
# so it is accepted only with an http://localhost APP_URL.
DEV_NEON_WS_PROXY=

# Optional. https:// URL that is pinged after every completed tick, also when a step failed
# (uptime monitoring: a missing ping means the tick did not run).
HEARTBEAT_URL=

# Optional. Node/Docker only: tick interval in milliseconds, integer >= 60000. Default: 900000
# (15 minutes). Vercel and Cloudflare tick every 15 minutes through their cron (vite.config.ts,
# wrangler.jsonc).
TICK_INTERVAL_MS=900000

# Optional. Node/Docker only: S3 storage for images (any S3 service; SeaweedFS in
# docker/compose.dev.yml). Set all five or none. The endpoint is https://, or http:// for localhost
# and 127.0.0.1; the bucket must exist. The SeaweedFS of docker/compose.dev.yml: endpoint
# http://localhost:8333, region us-east-1, bucket vereinsbote, access key vereinsbote, secret
# vereinsbote-dev-secret. On Vercel set BLOB_READ_WRITE_TOKEN of a private Blob
# store instead; on Cloudflare the R2 bucket binding MEDIA_BUCKET (wrangler.jsonc) is the storage.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional. Vercel only: the read-write token of a private Vercel Blob store (region chosen when
# the store is created, e.g. fra1).
BLOB_READ_WRITE_TOKEN=
