{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vereinsbote",
	// TanStack Start's handler plus the `scheduled` handler of the tick.
	"main": "./src/platform/cloudflare-worker.ts",
	"compatibility_date": "2026-11-17",
	"compatibility_flags": ["nodejs_compat"],
	// The tick, every 15 minutes (Spec 6.6).
	"triggers": { "crons": ["*/15 * * * *"] },
	// The settings of apps/web/.env.example are secrets of the Worker, never part of this file:
	// `wrangler secret put DATABASE_URL` (likewise APP_URL, APP_SECRET, CRON_SECRET and the optional
	// ones). Deploy with `vp run --filter web deploy:cloudflare` (DATABASE_URL in the shell): it
	// builds, migrates the database and then deploys, so a failed build never touches the database.
}
