<tr>
<td align="left" style="padding:0 20px 16px">
<h1 style="font-size:28px;line-height:36px;color:#111827;font-family:&quot;Merriweather&quot;, Georgia, &quot;Times New Roman&quot;, serif;font-weight:bold;margin:0;mso-line-height-rule:exactly">Einladung zum Sommerfest</h1>
</td>
</tr>
<tr>
